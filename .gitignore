# .NET build output — never track compiled artifacts or intermediate object files.
# These are regenerated by `dotnet build` and bloat the repo (159+ tracked files before this).
**/bin/
**/obj/

# Godot C# (.NET) build output — the equivalent of bin/obj for the Godot project.
godot/.godot/mono/

# Godot editor/import/shader caches — regenerated when the project is opened.
# ~22000 tracked files before this; they bloat the repo and differ per machine.
# .gdignore is kept (it's the intentional project marker, not a cache).
godot/.godot/editor/
godot/.godot/imported/
godot/.godot/shader_cache/
godot/.godot/global_script_class_cache.cfg
godot/.godot/scene_groups_cache.cfg
godot/.godot/uid_cache.bin

# Godot converted art assets — build product of the asset pipeline
# (godot/tools/run_full_pipeline.sh converts from binaries/data/mods/public/art
# via Blender). Regenerable on demand; do NOT track the ~19000 files / ~3GB.
# Run the pipeline after clone to repopulate godot/assets/.
godot/assets/

# Original 0 A.D. upstream trees — removed from this repo to slim it down.
# The C# rewrite reads data/assets verbatim from these via local directory
# junctions pointing at the upstream checkout (see tools/setup-upstream-junctions.ps1
# and AGENTS.md "Where to find the original C++/JS source"). Do NOT track them.
/binaries/
/build/
/libraries/
/source/

# macOS metadata — AppleDouble resource forks (`._*`) and Finder `.DS_Store`.
# These are binary files generated by macOS when copying files to non-HFS volumes;
# they match `**/*.cs` and break the C# compiler (CS2015: binary not text).
._*
.DS_Store

# IDE / editor-local state.
*.user
*.suo
.vs/
.vscode/
.idea/
.zcode/

# Local diagnostic output (asset-parsing reports, regenerated on demand).
godot/actor_diag.txt

# godot-mcp inspection tooling — local dev/inspection addon, not game code.
# Re-enabled in the editor on demand (Project Settings → Plugins); its autoload
# entries in project.godot are regenerated automatically when the plugin is enabled.
godot/addons/godot_mcp/

# Local MCP client config (machine-specific paths/ports). Copy from .mcp.json.example.
.mcp.json

# Generated map preview scenes (Project→Tools→Import/Generate; regenerable, ~100MB each)
godot/Scenes/Previews/

# Python bytecode caches — generated on script run (godot/tools/*.py), not source.
__pycache__/
*.pyc
asset_backups/

.cursor/
.omo/
.tasks/

binaries
build
libraries
source
.mimosa/
