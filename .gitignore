# .NET build output — never track compiled artifacts or intermediate object files.
# These are regenerated by `dotnet build` and bloat the repo (159+ tracked files before this).
**/bin/
**/obj/

# Godot C# (.NET) build output — the equivalent of bin/obj for the Godot project.
godot/.godot/mono/

# Godot editor/import/shader caches — regenerated when the project is opened.
# ~22000 tracked files before this; they bloat the repo and differ per machine.
# .gdignore is kept (it's the intentional project marker, not a cache).
godot/.godot/editor/
godot/.godot/imported/
godot/.godot/shader_cache/
godot/.godot/global_script_class_cache.cfg
godot/.godot/scene_groups_cache.cfg
godot/.godot/uid_cache.bin

# Original 0 A.D. C++ engine source — read-only reference for the rewrite.
# The C# port never consumes it at runtime (binaries/data/ holds the data assets).
source/

# IDE / editor-local state.
*.user
*.suo
.vs/
.vscode/
.idea/
.zcode/

# Local diagnostic output (asset-parsing reports, regenerated on demand).
godot/actor_diag.txt

# godot-mcp inspection tooling — local dev/inspection addon, not game code.
# Re-enabled in the editor on demand (Project Settings → Plugins); its autoload
# entries in project.godot are regenerated automatically when the plugin is enabled.
godot/addons/godot_mcp/

# Local MCP client config (machine-specific paths/ports). Copy from .mcp.json.example.
.mcp.json
